# Copy to ".env" and load it your own way, or set these in your shell.
# NEVER commit real values. ".env" is ignored by git.

# Needed only for live AI identification. Also requires, in Settings:
# provider = OpenAI and "Allow live, paid AI requests" ticked.
# OPENAI_API_KEY=

# Optional. Where the database and photos live (defaults: data/profit_hunter.db
# and data/images next to it).
# PROFIT_HUNTER_DB=
# PROFIT_HUNTER_IMAGES=

# TESTS ONLY, with a throwaway database: makes the mock provider pretend to
# bill, to rehearse cost limits. Do not set this for normal use.
# PROFIT_HUNTER_MOCK_BILLING=1
